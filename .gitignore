# Ephemeral fixture dir for scripts/migrations/lib/node-import-guard.spec.ts
# (mkdtemp inside the repo — tsx needs the fixture under a "type": "module"
# package so it goes through the ESM resolve hooks; removed in afterAll)
scripts/migrations/.node-import-guard-*/
scripts/migrations/snapshots/

# mvox-app#274 — seed-results/ is TRACKED by default (schema/type-provisioning
# and polyphony-synthetic ledgers, per the #263 convention). Only the one
# sensitive subdirectory the shared ledger writer (lib/ledger-writer.ts)
# routes crede real-PII instance runs into stays ignored — belt-and-suspenders
# alongside that writer's own field redaction; never commit real member data.
scripts/migrations/seed-results/crede-instance/
