# Claude Code per-user settings (not committed)
.claude/settings.local.json
.claude/worktrees/

# Node
node_modules/
*.log

# SvelteKit / Vite output
.output
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Paraglide generated output — regenerated by Vite plugin at build/dev time
src/lib/paraglide/

# Ephemeral fixture dir for scripts/migrations/lib/node-import-guard.spec.ts
# (mkdtemp inside the repo — tsx needs the fixture under a "type": "module"
# package so it goes through the ESM resolve hooks; removed in afterAll)
scripts/migrations/.node-import-guard-*/
scripts/migrations/snapshots/

# Seed run reports — may contain member PII (names, emails); never commit
scripts/migrations/seed-results/

# Crede seed scripts hardcode real member PII (names/emails) — keep out of git until redacted (Pérotin owns refactor)
scripts/migrations/seed-1*-crede-*.ts
scripts/migrations/seed-188-phase3b-crede-*.ts
