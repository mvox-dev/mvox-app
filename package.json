{
	"name": "mvox-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:workers && pnpm check:sw",
		"check:workers": "tsc -p workers/entu-rights-mcp/tsconfig.json --noEmit",
		"check:sw": "tsc -p tsconfig.sw.json --noEmit",
		"test": "vitest run",
		"test:changed": "vitest run --changed origin/main && vitest run src/comment-rules.spec.ts src/routes/page.line-cap.spec.ts src/lib/testing/rightsWrites.spec.ts",
		"test:roadmap": "vitest run scripts/roadmap",
		"test:watch": "vitest",
		"roadmap:fetch": "node --import tsx ./scripts/roadmap/fetch-issues.ts",
		"roadmap:render": "node --import tsx ./scripts/roadmap/render.ts",
		"mcp:bundle": "node --import tsx ./workers/entu-rights-mcp/generate-bundle.ts"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.23.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.0",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^20.11.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.6",
		"typescript": "^6.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"modern-screenshot": "^4.7.0",
		"pdfjs-dist": "^6.3.289"
	}
}
